# Backend API
VITE_API_BASE_URL=http://localhost:3000/api

# Image fallback base URL (Cloudinary images use absolute URLs)
VITE_IMAGE_BASE_URL=http://localhost:3000/uploads

# MQTT over WebSocket Secure (WSS)
VITE_MQTT_HOST=<cluster>.s1.eu.hivemq.cloud
VITE_MQTT_PORT=8884
VITE_MQTT_TOPIC=project-mektan/v1/data
VITE_MQTT_USERNAME=your-mqtt-username
VITE_MQTT_PASSWORD=your-mqtt-password
